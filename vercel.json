{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/extract.js": {
      "maxDuration": 60
    },
    "api/enrich.js": {
      "maxDuration": 60
    },
    "api/recommend.js": {
      "maxDuration": 30
    },
    "api/judge.js": {
      "maxDuration": 30
    },
    "api/pron.js": {
      "maxDuration": 30
    }
  }
}