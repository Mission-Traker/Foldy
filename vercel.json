{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/extract.js": {
      "maxDuration": 60
    },
    "api/enrich.js": {
      "maxDuration": 60
    },
    "api/recommend.js": {
      "maxDuration": 30
    },
    "api/judge.js": {
      "maxDuration": 30
    },
    "api/pron.js": {
      "maxDuration": 30
    },
    "api/lookup.js": {
      "maxDuration": 20
    },
    "api/ipa.js": {
      "maxDuration": 30
    },
    "api/story.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    }
  ]
}